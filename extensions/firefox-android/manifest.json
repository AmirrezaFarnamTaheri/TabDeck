{
  "manifest_version": 2,
  "name": "TabDeck Control Bridge for Firefox",
  "version": "1.1.0",
  "description": "Capture, preview, deduplicate and send Firefox Android tabs to the TabDeck control deck.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "optional_permissions": [
    "http://127.0.0.1:48721/*"
  ],
  "browser_action": {
    "default_title": "TabDeck tab control",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabdeck-bridge@tabdeck.local",
      "strict_min_version": "120.0"
    }
  }
}
